# Public Supabase project settings. The publishable key is safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Local UI-only dashboard preview. Enable only when testing without Supabase.
NEXT_PUBLIC_ENABLE_DASHBOARD_PREVIEW=false

# Optional legacy Firebase Analytics. Keep disabled until the approved privacy/
# consent flow and child-safety review allow it for the jurisdictions served.
# Firebase Auth and Firestore are no longer used by Fibonacci.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only backend origin used by Next.js route handlers. Set this in
# Vercel's Production environment to https://api.wizetale.com.
BACKEND_API_URL=http://localhost:8000

NEXT_PUBLIC_APP_NAME=Fibonacci
NEXT_PUBLIC_APP_VERSION=1.0.0
