# Copy to .env for local Docker Compose use. Never commit real values.
# Keep production here for deployment; set ENVIRONMENT=development for local containers.
ENVIRONMENT=production
API_ALLOWED_ORIGINS=https://wizetale.com,https://www.wizetale.com

# Supabase Auth, Postgres API, and private Storage
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_VIDEO_BUCKET=story-videos
MEDIA_STORAGE_PROVIDER=r2
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
MEDIA_SIGNED_URL_TTL_SECONDS=900

# Generation providers
GEMINI_API_KEY=
GEMINI_BILLING_TIER=unknown
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_TEXT_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GENERATION_MAX_IMAGES_PER_STORY=10
GENERATION_MAX_SCENES=10
RUNWARE_API_KEY=
AI_PROVIDER=gemini
IMAGE_PROVIDER=gemini
# Set IMAGE_PROVIDER=cloudflare and configure these server-side values for Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_TIMEOUT_SECONDS=180
IMAGE_GENERATION_CONCURRENCY=3
# Optional fal.ai provider configuration:
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux-2/turbo
FAL_IMAGE_TIMEOUT_SECONDS=180
FAL_IMAGE_CONCURRENCY=3
TTS_PROVIDER=edge

# Kazakh narration (Eleven v3); use Kazakh-capable voices licensed for your account.
ELEVENLABS_API_KEY=
ELEVENLABS_KK_FEMALE_VOICE_ID=
ELEVENLABS_KK_MALE_VOICE_ID=
